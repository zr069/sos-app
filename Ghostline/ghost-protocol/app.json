{
  "expo": {
    "name": "ghost-protocol",
    "slug": "ghost-protocol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ghost-protocol",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devoryit.ghostprotocol",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devoryit.ghostprotocol"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4145409319469605~1477950420",
          "iosAppId": "ca-app-pub-4145409319469605~1477950420"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46cfb613-be08-4096-9c0e-b24cae2fd283"
      }
    }
  }
}
